{
  "name": "library-info-cloudflare",
  "version": "1.0.0",
  "description": "图书馆实时流量和座位查询系统 - Cloudflare版",
  "type": "module",
  "scripts": {
    "deploy": "node deploy.js",
    "deploy:bash": "./deploy.sh",
    "deploy:worker": "cd worker && wrangler deploy",
    "deploy:pages": "cd pages && wrangler pages deploy .",
    "dev:worker": "cd worker && wrangler dev",
    "logs": "cd worker && wrangler tail"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "pages",
    "library",
    "seats",
    "traffic"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
